# For running OUTSIDE Snowflake (local / Streamlit Community Cloud). Copy to secrets.toml.
[connections.snowflake]
account   = "<orgname-accountname>"
user      = "<user>"
password  = "<password or PAT>"
role      = "MULEWATCH_ADMIN"
warehouse = "MULEWATCH_WH"
database  = "MULEWATCH"
schema    = "APP"
